<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ModerWarehousePlus</AssemblyName>
    <RootNamespace>ModerWarehouse</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- The game's DLLs are on the server already (Directory.Build.props). -->
    <CopyGameDlls>false</CopyGameDlls>
    <!-- The tests and the packages are projects and outputs of their own, not the plugin's files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;dist/**</DefaultItemExcludes>
    <NoWarn>CS0618;CS8632;CS0162;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
